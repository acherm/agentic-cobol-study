    {
      "ts": "2026-03-12T20:40:04.299000+00:00",
      "item": "Precedence:"
    },
    {
      "ts": "2026-03-12T20:40:04.299000+00:00",
      "item": "CODEC may be 0 (NONE) or 1 (RLESP)"
    },
    {
      "ts": "2026-03-12T20:40:04.299000+00:00",
      "item": "PAYLOAD_SIZE becomes variable for RLESP"
    },
    {
      "ts": "2026-03-12T20:40:04.299000+00:00",
      "item": "`tag` (1 byte)"
    },
    {
      "ts": "2026-03-12T20:40:04.299000+00:00",
      "item": "`0x00` = literal block"
    },
    {
      "ts": "2026-03-12T20:40:04.299000+00:00",
      "item": "`0x01` = space-run block"
    },
    {
      "ts": "2026-03-12T20:40:04.299000+00:00",
      "item": "otherwise invalid (error)"
    },
    {
      "ts": "2026-03-12T20:40:04.299000+00:00",
      "item": "`MIN_RUN = 4` (fixed)"
    },
    {
      "ts": "2026-03-12T20:40:04.299000+00:00",
      "item": "Scan input left\u2192right."
    },
    {
      "ts": "2026-03-12T20:40:04.299000+00:00",
      "item": "When a run of spaces length `r >= MIN_RUN`, emit a space-run block."
    },
    {
      "ts": "2026-03-12T20:40:04.299000+00:00",
      "item": "Otherwise include bytes in literal blocks."
    },
    {
      "ts": "2026-03-12T20:40:04.299000+00:00",
      "item": "Literal blocks may be merged up to a max size:"
    },
    {
      "ts": "2026-03-12T20:40:04.299000+00:00",
      "item": "`MAX_LIT = 65535` (since len uint16)"
    },
    {
      "ts": "2026-03-12T20:40:04.299000+00:00",
